-	typename REGION_TEMP::ConstIterator itHereT;
-	INDEX tnX;
-		// Used to loop through points.
-
-	// Make sure they didn't start us off with an error.
-	assert (a_reStatus == g_kNoError);
-
-	// Calculate the union.
-	a_rTemp.Assign (a_reStatus, *this);
