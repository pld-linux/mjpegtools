-	for (itHereO = a_rOther.Begin();
-		 itHereO != a_rOther.End();
-		 ++itHereO)
-	{
-		const Extent &rHere = *itHere;
-		for (tnX = rHere.m_tnXStart; tnX < rHere.m_tnXEnd; ++tnX)
-		{
-			if (a_rTemp.DoesContainPoint (rHere.m_tnY, tnX))
-				goto error;
